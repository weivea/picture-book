{
  "name": "picture-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-powered children's picture book creator (Codex Desktop skills)",
  "scripts": {
    "setup": "bun install && bun run setup:venv",
    "setup:venv": "bun run scripts/setup-venv.ts",
    "image": "bun run .codex/skills/image-generation/scripts/generate-image.ts",
    "images": "bun run .codex/skills/picture-book-creator/scripts/generate-images.ts",
    "epub": "bun run .codex/skills/picture-book-creator/scripts/generate-epub.ts",
    "audio": "bun run .codex/skills/text-to-speech/scripts/generate-audio.ts",
    "audio-pages": "bun run .codex/skills/audio-picture-book-creator/scripts/generate-audio-pages.ts",
    "audio-epub": "bun run .codex/skills/audio-picture-book-creator/scripts/generate-audio-epub.ts",
    "test": "bun test ./.codex/skills/"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jszip": "^3.4.1"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "oxipng-bin": "^1.0.0",
    "pngquant-bin": "^9.0.0"
  },
  "trustedDependencies": [
    "pngquant-bin",
    "oxipng-bin"
  ]
}
