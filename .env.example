# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is committed as a template.
#
# 用法：
#   cp .env.example .env
#   # 编辑 .env 填入真实 key
#   export $(grep -v '^#' .env | xargs)        # 加载到当前 shell
#   # 或用 direnv / dotenv 工具自动加载

# Azure gpt-image-2 部署的 API key（image-generation skill 必需）
AZURE_API_KEY=<your-azure-api-key>

# 可选：覆盖默认的 Azure 图像生成端点 URL（更换部署 / 区域时使用）
# 默认值见 .claude/skills/image-generation/scripts/generate-image.ts
# AZURE_IMAGE_ENDPOINT=
