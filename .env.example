# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is committed as a template.
#
# 用法：
#   cp .env.example .env
#   # 编辑 .env 填入真实 key
#   # Codex/Bun 脚本会从当前目录向上自动查找并加载第一个 .env
#   # 也可以在启动 Codex Desktop App 前把变量导出到父 shell

# Azure gpt-image-2 部署的 API key（image-generation skill 必需）
AZURE_API_KEY=<your-azure-api-key>

# Azure 图像生成端点 URL（必填，公开仓库默认值仅是占位符）
# 形如：https://<your-resource-name>.cognitiveservices.azure.com/openai/deployments/gpt-image-2/images/generations?api-version=2024-02-01
AZURE_IMAGE_ENDPOINT=<your-azure-image-endpoint>
