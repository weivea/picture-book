# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is committed as a template.
#
# 用法：
#   cp .env.example .env
#   # 编辑 .env 填入真实 key
#   export $(grep -v '^#' .env | xargs)        # 加载到当前 shell
#   # 或用 direnv / dotenv 工具自动加载

# Azure gpt-image-2 部署的 API key（image-generation skill 必需）
AZURE_API_KEY=<your-azure-api-key>

# Azure 图像生成端点 URL（必填，公开仓库默认值仅是占位符）
# 形如：https://<your-resource-name>.cognitiveservices.azure.com/openai/deployments/gpt-image-2/images/generations?api-version=2024-02-01
AZURE_IMAGE_ENDPOINT=<your-azure-image-endpoint>

# Azure Speech 资源的 API key（text-to-speech skill 必需）
AZURE_SPEECH_KEY=<your-azure-speech-key>

# Azure Speech 资源端点 URL（text-to-speech skill 必需）
# 形如：https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_SPEECH_ENDPOINT=<your-azure-speech-endpoint>
